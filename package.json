{
  "name": "second-hand",
  "private": true,
  "version": "0.1.0",
  "description": "SECOND HAND — a time-rewind action roguelite",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && python3 tools/subset-fonts.py && vite build",
    "build:single": "tsc --noEmit && python3 tools/subset-fonts.py && vite build --mode single",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "subset-fonts": "python3 tools/subset-fonts.py"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
